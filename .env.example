# Anthropic
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron protection (required for /api/cron/update)
CRON_SECRET=

# Optional: override the Claude model used for LLM calls.
# Default is claude-sonnet-4-5; bump to claude-sonnet-4-6 (or newer) when ready.
ANTHROPIC_MODEL=claude-sonnet-4-5
